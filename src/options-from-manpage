"""Extract and format options and program names from an mdoc manpage file."""

from __future__ import annotations

import argparse
import re
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Final, Sequence


opPattern: Final[re.Pattern[str]]        = re.compile(r"^\.Op(?:\s+(.*))?$")
nmPattern: Final[re.Pattern[str]]        = re.compile(r"^\.Nm(?:\s+(.*))?$")
noPattern: Final[re.Pattern[str]]        = re.compile(r"^\.(No|Ar|Cm|Sy|Bro)(?:\s+(.*))?$")
shPattern: Final[re.Pattern[str]]        = re.compile(r"^\.Sh(?:\s+(.*))?$")
syPattern: Final[re.Pattern[str]]        = re.compile(r"^\.Sy(?:\s+(.*))?$")

defaultFormat: Final[str]                = "syntax"
supportedFormats: Final[tuple[str, ...]] = (
   "syntax",
   "options-only",
   "usage-c",
   "usage-c++",
   "usage-shell",
   "usage-perl",
)

# ANSI style escape codes
styleBold: Final[str]      = "\x1b[1m"
styleUnderline: Final[str] = "\x1b[4m"
styleReset: Final[str]     = "\x1b[0m"

macroTokens: Final[set[str]] = { "Fl", "Ar", "No", "Op", "Cm", "Sy", "Bro", "Brc", "|", "--" }


