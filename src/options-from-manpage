"""Extract and format options and program names from an mdoc manpage file."""

from __future__ import annotations

import argparse
import re
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Final, Sequence


opPattern: Final[re.Pattern[str]]        = re.compile(r"^\.Op(?:\s+(.*))?$")
nmPattern: Final[re.Pattern[str]]        = re.compile(r"^\.Nm(?:\s+(.*))?$")
noPattern: Final[re.Pattern[str]]        = re.compile(r"^\.(?:No|Ar)(?:\s+(.*))?$")
shPattern: Final[re.Pattern[str]]        = re.compile(r"^\.Sh(?:\s+(.*))?$")

defaultFormat: Final[str]                = "syntax"
supportedFormats: Final[tuple[str, ...]] = (
   "syntax",
   "options-only",
   "usage-c",
   "usage-c++",
   "usage-shell",
)

# ANSI style escape codes
styleBold: Final[str]      = "\033[1m"
styleUnderline: Final[str] = "\033[4m"
styleReset: Final[str]     = "\033[0m"


# ###### C usage function definitions #######################################
cUsageHead: Final[tuple[str, ...]]              = (
   "// ###### Usage #############################################################",
   "#if defined(__STDC_VERSION__) && (__STDC_VERSION__ >= 202000L)",
   "[[ noreturn ]]",
   "#endif",
   "static void usage(const char* program, const int exitCode)",
   "{",
)
cUsageTail: Final[tuple[str, ...]]              = (
   "   exit(exitCode);",
   "}",
)
cTranslatorsComment: Final[tuple[str, ...]]     = (
   "   // TRANSLATORS: Command-line syntax message prefix:",
   '   // "Usage: <program> [options]".',
)


# ###### C++ usage function definitions #####################################
cppUsageHead: Final[tuple[str, ...]]            = (
   "// ###### Usage #############################################################",
   "[[ noreturn ]]",
   "static void usage(const char* program, const int exitCode)",
   "{",
)
cppUsageTail: Final[tuple[str, ...]]            = (
   "   exit(exitCode);",
   "}",
)
cppTranslatorsComment: Final[tuple[str, ...]]   = (
   "   // TRANSLATORS: Command-line syntax message prefix:",
   '   // "Usage: <program> [options]".',
)


# ###### Shell usage function definitions ###################################
shellUsageHead: Final[tuple[str, ...]]          = (
   "# ###### Usage ##############################################################",
   "usage () {",
   '   local exitCode="$1"',
   "   local bold=$'\\033[1m'",
   "   local underline=$'\\033[4m'",
   "   local reset=$'\\033[0m'",
)
shellUsageTail: Final[tuple[str, ...]]          = (
   '   exit "${exitCode}"',
   "}",
)
shellTranslatorsComment: Final[tuple[str, ...]] = (
   "   # TRANSLATORS: Command-line syntax message prefix:",
   '   # "Usage: <program> [options]".',
)


@dataclass(frozen = True)
class CommandEntry:
   """Represents a .Nm macro occurrence with program name and optional arguments."""

   name: str
   args: str = ""


@dataclass(frozen = True)
class OptionEntry:
   """Represents a .Op macro occurrence with formatted option text."""

   text:        str
   optionsOnly: str


Entry = CommandEntry | OptionEntry


# ###### Parse tokens from manpage ##########################################
def parseTokens(
   tokens: Sequence[str],
   includeArgs: bool = True,
   useStyles: bool   = False,
) -> str:
   r"""Parse tokens from an option or argument line.

   Handles:
   - 'Fl' represents '-'
   - 'Fl Fl <opt>' or 'Fl \-<opt>' produces '--<opt>'
   - 'Ar' designates the next token as an argument value
   - 'No' switches back to normal font
   """
   words: Final[list[str]] = []
   i: int                  = 0
   total: Final[int]       = len(tokens)

   while i < total:
      token: str = tokens[i]

      if token == "Fl":
         dashCount: int = 0
         while i < total and tokens[i] == "Fl":
            dashCount += 1
            i += 1

         # Handle standalone '-' tokens (e.g. from unescaped '\-'):
         while i < total and tokens[i] == "-":
            dashCount += 1
            i += 1

         if i < total and tokens[i] not in ("Fl", "Ar", "No", "|"):
            word: str        = tokens[i]
            stripped: str    = word.lstrip("-")
            extraDashes: int = len(word) - len(stripped)

            if extraDashes > 0 and stripped:
               dashCount += extraDashes
               optStr: str = f"{'-' * dashCount}{stripped}"
               i += 1
            else:
               optStr = f"{'-' * dashCount}{word}"
               i += 1
         else:
            optStr = "-" * dashCount

         if useStyles:
            words.append(f"{styleBold}{optStr}{styleReset}")
         else:
            words.append(optStr)

      elif token == "Ar":
         i += 1
         if i < total:
            argVal: str = tokens[i]
            if includeArgs:
               if useStyles:
                  words.append(f"{styleUnderline}{argVal}{styleReset}")
               else:
                  words.append(argVal)
            i += 1

      elif token == "No":
         i += 1

      elif token in ("|", "{", "}"):
         if useStyles:
            words.append(f"{styleBold}{token}{styleReset}")
         else:
            words.append(token)
         i += 1

      else:
         words.append(token)
         i += 1

   return " ".join(words)


# ###### Parse manpage ######################################################
def parseManpage(filePath: Path) -> list[Entry]:
   """Parse a manpage line-by-line, capturing .Nm, required arguments, and .Op directives."""
   entries: Final[list[Entry]] = []
   firstProgramName: str       = ""

   with filePath.open("r", encoding="utf-8", errors="replace") as stream:
      lines: Final[list[str]] = stream.readlines()

   # If .Sh SYNOPSIS exists, scope option extraction to that section.
   # If no .Sh sections exist (e.g. raw test snippets), parse the entire file.
   hasSynopsisSection: Final[bool] = any(
      bool(m and m.group(1) and m.group(1).strip() == "SYNOPSIS")
      for line in lines
      for m in [shPattern.match(line.rstrip("\r\n"))]
   )
   inSynopsis: bool                = not hasSynopsisSection

   for line in lines:
      stripped: str = line.rstrip("\r\n")

      # Track section headers (.Sh):
      shMatch: re.Match[str] | None = shPattern.match(stripped)
      if shMatch:
         sectionName: str = (shMatch.group(1) or "").strip()
         inSynopsis       = sectionName == "SYNOPSIS"
         continue

      if not inSynopsis:
         continue

      # Track program names (.Nm):
      nmMatch: re.Match[str] | None = nmPattern.match(stripped)
      if nmMatch:
         rawArg: str | None = nmMatch.group(1)
         cleanedName: str   = ""
         trailingArgs: str  = ""

         if rawArg:
            cleanedNm: str = (
               rawArg.replace(r"\_", "_")
               .replace(r"\-", "-")
               .replace(r"\%", "")
               .strip()
            )
            nmTokens: list[str] = cleanedNm.split()
            if nmTokens:
               cleanedName = nmTokens[0]
               if len(nmTokens) > 1:
                  trailingArgs = parseTokens(
                     nmTokens[1:], includeArgs = True, useStyles = True
                  )

            if not firstProgramName:
               firstProgramName = cleanedName
         elif firstProgramName:
            cleanedName = firstProgramName

         entries.append(
            CommandEntry(
               name = cleanedName or firstProgramName,
               args = trailingArgs,
            )
         )
         continue

      # Track required command arguments following .Nm (.No / .Ar):
      noMatch: re.Match[str] | None = noPattern.match(stripped)
      if noMatch:
         noContent: str = (
            (noMatch.group(1) or "")
            .replace(r"\_", "_")
            .replace(r"\-", "-")
            .replace(r"\%", "")
         )
         noTokens: list[str] = noContent.split()
         if noTokens and entries:
            lastEntry: Entry = entries[-1]
            if isinstance(lastEntry, CommandEntry):
               extraArgs: str    = parseTokens(
                  noTokens, includeArgs = True, useStyles = True
               )
               combinedArgs: str = (
                  f"{lastEntry.args} {extraArgs}".strip()
                  if lastEntry.args
                  else extraArgs
               )
               entries[-1] = CommandEntry(name = lastEntry.name, args = combinedArgs)
         continue

      # Track option definitions (.Op):
      opMatch: re.Match[str] | None = opPattern.match(stripped)
      if opMatch:
         opContent: str = (
            (opMatch.group(1) or "")
            .replace(r"\_", "_")
            .replace(r"\-", "-")
            .replace(r"\%", "")
         )
         opTokens: list[str] = opContent.split()
         if opTokens:
            styledInner: str = parseTokens(
               opTokens, includeArgs = True, useStyles = True
            )
            textVal: str    = f"{styleBold}[{styleReset}{styledInner}{styleBold}]{styleReset}"
            optOnlyVal: str = parseTokens(
               opTokens, includeArgs = False, useStyles = False
            )
            entries.append(OptionEntry(text = textVal, optionsOnly = optOnlyVal))

   return entries


# ###### Sorting order for options ##########################################
def sortOptionKey(opt: OptionEntry) -> tuple[int, str, str]:
   """Key for sorting options: short options first (0), long options second (1), other third (2)."""
   plain: str = (
      opt.text.replace(styleBold, "")
      .replace(styleUnderline, "")
      .replace(styleReset, "")
      .lstrip("[")
      .strip()
   )
   priority: int
   if plain.startswith("-") and not plain.startswith("--"):
      priority = 0
   elif plain.startswith("--"):
      priority = 1
   else:
      priority = 2
   return (priority, plain.casefold(), plain)


# ###### Sort option entries ################################################
def sortEntries(entries: Sequence[Entry]) -> list[Entry]:
   """Sort option entries per program name (.Nm): short options first, then long options."""
   sortedEntries: Final[list[Entry]]        = []
   currentOptions: Final[list[OptionEntry]] = []

   def flushOptions() -> None:
      if currentOptions:
         currentOptions.sort(key = sortOptionKey)
         sortedEntries.extend(currentOptions)
         currentOptions.clear()

   for entry in entries:
      if isinstance(entry, CommandEntry):
         flushOptions()
         sortedEntries.append(entry)
      elif isinstance(entry, OptionEntry):
         currentOptions.append(entry)

   flushOptions()
   return sortedEntries


# ###### Write "syntax" output ##############################################
def renderSyntax(entries: Sequence[Entry]) -> str:
   """Render entries with program names, required arguments, and tab-indented option syntax."""
   lines: Final[list[str]] = []
   for entry in entries:
      if isinstance(entry, CommandEntry):
         styledName: str = f"{styleBold}{entry.name}{styleReset}"
         if entry.args:
            lines.append(f"{styledName} {entry.args}")
         else:
            lines.append(styledName)
      elif isinstance(entry, OptionEntry):
         lines.append(f"\t{entry.text}")
   return "\n".join(lines)


# ###### Write "options-only" output ########################################
def renderOptionsOnly(entries: Sequence[Entry]) -> str:
   """Render only option definitions without program names or arguments."""
   lines: Final[list[str]] = [
      entry.optionsOnly
      for entry in entries
      if isinstance(entry, OptionEntry)
   ]
   return "\n".join(lines)


# ###### Write "usage-c" output #############################################
def renderUsageC(entries: Sequence[Entry], withGettext: bool = False) -> str:
   """Generate a complete C usage() function with fprintf(stderr, ...)."""
   lines: Final[list[str]] = list(cUsageHead)

   if withGettext:
      lines.extend(cTranslatorsComment)

   indent: Final[str]      = " " * 11
   usageHeader: Final[str] = "%s" if withGettext else "Usage:"

   if not entries:
      if withGettext:
         lines.append(f'   fprintf(stderr, "%s\\n",\n{indent}gettext("Usage:"));')
      else:
         lines.append('   fprintf(stderr, "Usage:\\n");')
      lines.extend(cUsageTail)
      return "\n".join(lines)

   nmCount: Final[int] = sum(1 for e in entries if isinstance(e, CommandEntry))
   lines.append(f'   fprintf(stderr, "{usageHeader}\\n"')

   for entry in entries:
      if isinstance(entry, CommandEntry):
         if entry.args:
            escapedArgs: str = (
               entry.args.replace("\\", "\\\\")
               .replace("\033", "\\033")
               .replace('"', '\\"')
               .replace("%", "%%")
            )
            lines.append(f'{indent}"\\033[1m%s\\033[0m {escapedArgs}\\n"')
         else:
            lines.append(f'{indent}"\\033[1m%s\\033[0m\\n"')
      elif isinstance(entry, OptionEntry):
         escapedOpt: str = (
            entry.text.replace("\\", "\\\\")
            .replace("\033", "\\033")
            .replace('"', '\\"')
            .replace("%", "%%")
         )
         lines.append(f'{indent}"\\t{escapedOpt}\\n"')

   arguments: Final[list[str]] = []
   if withGettext:
      arguments.append('gettext("Usage:")')
   if nmCount > 0:
      arguments.extend(["program"] * nmCount)

   if arguments:
      lines[-1] = lines[-1] + ","
      argsList: Final[str] = ", ".join(arguments)
      lines.append(f"{indent}{argsList});")
   else:
      lines[-1] = lines[-1] + ");"

   lines.extend(cUsageTail)
   return "\n".join(lines)


# ###### Write "usage-c++" output ###########################################
def renderUsageCpp(entries: Sequence[Entry], withGettext: bool = False) -> str:
   """Generate a complete C++ usage() function with std::cerr using string concatenation."""
   lines: Final[list[str]] = list(cppUsageHead)

   if withGettext:
      lines.extend(cppTranslatorsComment)

   if not entries:
      if withGettext:
         lines.append('   std::cerr << gettext("Usage:") << "\\n";')
      else:
         lines.append('   std::cerr << "Usage:\\n";')
      lines.extend(cppUsageTail)
      return "\n".join(lines)

   if withGettext:
      lines.append('   std::cerr << gettext("Usage:") << "\\n"')
   else:
      lines.append('   std::cerr << "Usage:\\n"')

   for entry in entries:
      if isinstance(entry, CommandEntry):
         if entry.args:
            escapedArgs: str = (
               entry.args.replace("\\", "\\\\")
               .replace("\033", "\\033")
               .replace('"', '\\"')
            )
            lines.append(f'             << "\\033[1m" << program << "\\033[0m {escapedArgs}\\n"')
         else:
            lines.append('             << "\\033[1m" << program << "\\033[0m\\n"')
      elif isinstance(entry, OptionEntry):
         escapedOpt: str = (
            entry.text.replace("\\", "\\\\")
            .replace("\033", "\\033")
            .replace('"', '\\"')
         )
         lines.append(f'                "\\t{escapedOpt}\\n"')

   lines[-1] = lines[-1] + ";"
   lines.extend(cppUsageTail)
   return "\n".join(lines)


# ###### Write "usage-shell" output #########################################
def renderUsageShell(entries: Sequence[Entry], withGettext: bool = False) -> str:
   """Generate a complete Shell/Bash usage() function using a here-document."""
   lines: Final[list[str]] = list(shellUsageHead)

   if withGettext:
      lines.extend(shellTranslatorsComment)

   usageHeader: Final[str] = (
      '$(gettext "Usage:")' if withGettext else "Usage:"
   )

   if not entries:
      lines.extend([
         "   cat >&2 <<EOF",
         f"{usageHeader}",
         "EOF",
      ])
      lines.extend(shellUsageTail)
      return "\n".join(lines)

   lines.extend([
      "   cat >&2 <<EOF",
      f"{usageHeader}",
   ])

   for entry in entries:
      if isinstance(entry, CommandEntry):
         if entry.args:
            escapedArgs: str = (
               entry.args.replace("\\", "\\\\")
               .replace('"', '\\"')
               .replace("$", "\\$")
               .replace("`", "\\`")
               .replace(styleBold, "${bold}")
               .replace(styleUnderline, "${underline}")
               .replace(styleReset, "${reset}")
            )
            lines.append(f"${{bold}}$0${{reset}} {escapedArgs}")
         else:
            lines.append("${bold}$0${reset}")
      elif isinstance(entry, OptionEntry):
         escapedOpt: str = (
            entry.text.replace("\\", "\\\\")
            .replace('"', '\\"')
            .replace("$", "\\$")
            .replace("`", "\\`")
            .replace(styleBold, "${bold}")
            .replace(styleUnderline, "${underline}")
            .replace(styleReset, "${reset}")
         )
         lines.append(f"\t{escapedOpt}")

   lines.append("EOF")
   lines.extend(shellUsageTail)
   return "\n".join(lines)


# ###### Write output #######################################################
def renderOutput(
   entries: Sequence[Entry],
   outputFormat: str,
   withGettext: bool = False,
) -> str:
   """Route entries to the requested output formatter."""
   fmt: Final[str] = outputFormat.strip().lower()
   if fmt == "syntax":
      return renderSyntax(entries)
   if fmt == "options-only":
      return renderOptionsOnly(entries)
   if fmt == "usage-c":
      return renderUsageC(entries, withGettext = withGettext)
   if fmt in ("usage-c++", "usage-cpp"):
      return renderUsageCpp(entries, withGettext = withGettext)
   if fmt in ("usage-shell", "usage-bash"):
      return renderUsageShell(entries, withGettext = withGettext)

   raise ValueError(
      f"Unsupported format '{outputFormat}'. "
      f"Supported: 'syntax', 'options-only', 'usage-c', 'usage-c++', 'usage-shell'."
   )


# ###### Arguments parser ###################################################
def buildParser() -> argparse.ArgumentParser:
   """Build command-line arguments."""
   parser: Final[argparse.ArgumentParser] = argparse.ArgumentParser(
      description = "Extract and format options from an mdoc manpage file."
   )
   parser.add_argument(
      "manpage",
      type = Path,
      help = "Path to the manpage file."
   )
   parser.add_argument(
      "-F", "--format",
      dest    = "format",
      default = defaultFormat,
      choices = list(supportedFormats),
      help    = "Output format: 'syntax' (default), 'options-only', 'usage-c', 'usage-c++', or 'usage-shell'."
   )
   parser.add_argument(
      "-g", "--with-gettext",
      dest    = "withGettext",
      action  = "store_true",
      default = False,
      help    = 'Use gettext("Usage:") for internationalization in "usage-c", "usage-c++", and "usage-shell" output.'
   )
   parser.add_argument(
      "-s", "--sorted",
      dest    = "isSorted",
      action  = "store_true",
      default = False,
      help    = "Sort option lines per program name alphabetically (short options first, then long options)."
   )
   return parser


# ###### Parse manpage and write output #####################################
def main(argv: Sequence[str] | None = None) -> int:
   parser: Final[argparse.ArgumentParser] = buildParser()
   args: Final[argparse.Namespace]        = parser.parse_args(argv)

   if not args.manpage.is_file():
      sys.stderr.write(f"ERROR: File not found: '{args.manpage}'\n")
      return 1

   try:
      rawEntries: Final[list[Entry]] = parseManpage(args.manpage)
      entries: Final[Sequence[Entry]] = (
         sortEntries(rawEntries) if args.isSorted else rawEntries
      )

      output: Final[str] = renderOutput(
         entries,
         outputFormat = args.format,
         withGettext  = args.withGettext,
      )
      if output:
         print(output)
   except Exception as err:
      sys.stderr.write(f"ERROR: {err}\n")
      return 1

   return 0


# ###### Main program #######################################################
if __name__ == "__main__":
   sys.exit(main())
