@dataclass(frozen = True)
class CommandEntry:
   """Represents a program name or section header (.Nm / .Sy) with optional leading arguments."""

   name:      str
   args:      str = ""
   macroArgs: str = ""


@dataclass(frozen = True)
class OptionEntry:
   """Represents a .Op macro occurrence with formatted option text."""

   text:        str
   optionsOnly: str
   macroText:   str


@dataclass(frozen = True)
class ArgumentEntry:
   """Represents trailing operands following options (e.g. -- command [argument ...])."""

   text:      str
   macroText: str


Entry = CommandEntry | OptionEntry | ArgumentEntry


# ###### Clean mdoc escape sequences ########################################
def cleanMdocEscapes(text: str) -> str:
   r"""Strip roff escapes, hyphenation hints (\%), break hints (\:), and formatting."""
   cleaned: str = (
      text.replace(r"\%", "")   # Strip hyphenation hints FIRST before consuming '\'
      .replace(r"\:", "")       # Strip zero-width break points
      .replace(r"\_", "_")       # Convert escaped underscores
      .replace(r"\-", "-")       # Convert escaped dashes
   )
   # Clean up any stray unescaped % within word/underscore identifiers (e.g. _%frame)
   return re.sub(r"(?<=[a-zA-Z0-9_])%(?=[a-zA-Z0-9_])", "", cleaned)


# ###### Parse tokens from manpage ##########################################
def parseTokens(
   tokens: Sequence[str],
   includeArgs: bool = True,
   useStyles: bool   = False,
) -> str:
   r"""Parse tokens from an option or argument line into ANSI or plain text."""
   words: Final[list[str]] = []
   i: int                  = 0
   total: Final[int]       = len(tokens)

   while i < total:
      token: str = tokens[i]

      if token == "Fl":
         dashCount: int = 0
         while i < total and tokens[i] == "Fl":
            dashCount += 1
            i += 1

         while i < total and tokens[i] == "-":
            dashCount += 1
            i += 1

         if i < total and tokens[i] not in macroTokens:
            word: str        = tokens[i]
            stripped: str    = word.lstrip("-")
            extraDashes: int = len(word) - len(stripped)

            if extraDashes > 0 and stripped:
               dashCount += extraDashes
               optStr: str = f"{'-' * dashCount}{stripped}"
               i += 1
            else:
               optStr = f"{'-' * dashCount}{word}"
               i += 1
         else:
            optStr = "-" * dashCount

         if useStyles:
            words.append(f"{styleBold}{optStr}{styleReset}")
         else:
            words.append(optStr)

      elif token == "Ar":
         i += 1
         while i < total:
            if tokens[i] == "|":
               if i + 1 < total and tokens[i + 1] not in macroTokens:
                  if includeArgs:
                     words.append(f"{styleBold}|{styleReset}" if useStyles else "|")
                  i += 1
                  continue
               else:
                  break
            elif tokens[i] in macroTokens:
               break
            else:
               argVal: str = tokens[i]
               if argVal == "...":
                  if includeArgs:
                     words.append("...")
               else:
                  if includeArgs:
                     if useStyles:
                        words.append(f"{styleUnderline}{argVal}{styleReset}")
                     else:
                        words.append(argVal)
               i += 1

      elif token == "No":
         i += 1
         while i < total and tokens[i] not in macroTokens:
            words.append(tokens[i])
            i += 1

      elif token in ("Cm", "Sy"):
         i += 1
         while i < total:
            if tokens[i] == "|":
               if i + 1 < total and tokens[i + 1] not in macroTokens:
                  if includeArgs:
                     words.append(f"{styleBold}|{styleReset}" if useStyles else "|")
                  i += 1
                  continue
               else:
                  break
            elif tokens[i] in macroTokens:
               break
            else:
               argVal: str = tokens[i]
               if includeArgs:
                  words.append(f"{styleBold}{argVal}{styleReset}" if useStyles else argVal)
               i += 1

      elif token == "Bro":
         # Find matching Brc enclosure
         depth: int = 1
         j: int     = i + 1
         while j < total:
            if tokens[j] == "Bro":
               depth += 1
            elif tokens[j] == "Brc":
               depth -= 1
               if depth == 0:
                  break
            j += 1

         if j < total and tokens[j] == "Brc":
            if includeArgs:
               inner: str = parseTokens(
                  tokens[i + 1 : j], includeArgs = includeArgs, useStyles = useStyles
               )
               if useStyles:
                  words.append(f"{styleBold}{{{styleReset}{inner}{styleBold}}}{styleReset}")
               else:
                  words.append(f"{{{inner}}}")
            i = j + 1
         else:
            if includeArgs:
               words.append(f"{styleBold}{{{styleReset}" if useStyles else "{")
            i += 1

      elif token == "Brc":
         if includeArgs:
            words.append(f"{styleBold}}}{styleReset}" if useStyles else "}")
         i += 1

      elif token == "Op":
         i += 1
         inner: str = parseTokens(tokens[i:], includeArgs = includeArgs, useStyles = useStyles)
         if useStyles:
            words.append(f"{styleBold}[{styleReset}{inner}{styleBold}]{styleReset}")
         else:
            words.append(f"[{inner}]")
         break

      elif token in ("|", "--"):
         if useStyles:
            words.append(f"{styleBold}{token}{styleReset}")
         else:
            words.append(token)
         i += 1

      else:
         words.append(token)
         i += 1

   return " ".join(words)


# ###### Parse tokens into C/C++ macros #####################################
def parseTokensMacro(tokens: Sequence[str]) -> str:
   r"""Parse tokens into C/C++ preprocessor macro invocations (OPT, ARG, SYN, PIPE)."""
   parts: Final[list[str]] = []
   i: int                  = 0
   total: Final[int]       = len(tokens)

   while i < total:
      token: str = tokens[i]

      if token == "Fl":
         dashCount: int = 0
         while i < total and tokens[i] == "Fl":
            dashCount += 1
            i += 1

         while i < total and tokens[i] == "-":
            dashCount += 1
            i += 1

         if i < total and tokens[i] not in macroTokens:
            word: str        = tokens[i]
            stripped: str    = word.lstrip("-")
            extraDashes: int = len(word) - len(stripped)

            if extraDashes > 0 and stripped:
               dashCount += extraDashes
               optStr: str = f"{'-' * dashCount}{stripped}"
               i += 1
            else:
               optStr = f"{'-' * dashCount}{word}"
               i += 1
         else:
            optStr = "-" * dashCount

         parts.append(f'OPT("{optStr}")')

      elif token == "Ar":
         i += 1
         while i < total:
            if tokens[i] == "|":
               if i + 1 < total and tokens[i + 1] not in macroTokens:
                  parts.append("PIPE")
                  i += 1
                  continue
               else:
                  break
            elif tokens[i] in macroTokens:
               break
            else:
               argVal: str = tokens[i]
               if argVal == "...":
                  parts.append('"..."')
               else:
                  parts.append(f'ARG("{argVal}")')
               i += 1

      elif token in ("Cm", "Sy"):
         i += 1
         while i < total:
            if tokens[i] == "|":
               if i + 1 < total and tokens[i + 1] not in macroTokens:
                  parts.append("PIPE")
                  i += 1
                  continue
               else:
                  break
            elif tokens[i] in macroTokens:
               break
            else:
               parts.append(f'SYN("{tokens[i]}")')
               i += 1

      elif token == "Bro":
         parts.append('SYN("{")')
         i += 1

      elif token == "Brc":
         parts.append('SYN("}")')
         i += 1

      elif token == "No":
         i += 1
         while i < total and tokens[i] not in macroTokens:
            parts.append(f'"{tokens[i]}"')
            i += 1

      elif token == "Op":
         i += 1
         innerMacro: str = parseTokensMacro(tokens[i:])
         parts.append(f'SYN("[") {innerMacro} SYN("]")')
         break

      elif token == "|":
         parts.append("PIPE")
         i += 1

      elif token in ("[", "]", "--"):
         parts.append(f'SYN("{token}")')
         i += 1

      else:
         parts.append(f'"{token}"')
         i += 1

   if not parts:
      return ""

   res: Final[list[str]] = []
   for idx, p in enumerate(parts):
      if idx == 0:
         res.append(p)
         continue
      prev: str = parts[idx - 1]
      if prev == "PIPE" or p == "PIPE":
         res.append(f" {p}")
      elif prev.endswith('SYN("[")') or p.startswith('SYN("]")'):
         res.append(f" {p}")
      elif prev.endswith('SYN("{")') or p.startswith('SYN("}")'):
         res.append(f" {p}")
      else:
         res.append(f' " " {p}')
   return "".join(res)


# ###### Parse manpage ######################################################
def parseManpage(filePath: Path) -> tuple[list[Entry], str]:
   """Parse a manpage line-by-line, capturing .Nm, .Sy, options, and arguments."""
   entries: Final[list[Entry]] = []
   firstProgramName: str       = ""
   hasSeenOptionsForCmd: bool  = False

   with filePath.open("r", encoding="utf-8", errors="replace") as stream:
      lines: Final[list[str]] = stream.readlines()

   hasSynopsisSection: Final[bool] = any(
      bool(m and m.group(1) and m.group(1).strip() == "SYNOPSIS")
      for line in lines
      for m in [shPattern.match(line.rstrip("\r\n"))]
   )
   inSynopsis: bool                = not hasSynopsisSection

   for line in lines:
      stripped: str = line.rstrip("\r\n")

      shMatch: re.Match[str] | None = shPattern.match(stripped)
      if shMatch:
         sectionName: str = (shMatch.group(1) or "").strip()
         inSynopsis       = sectionName == "SYNOPSIS"
         continue

      if not inSynopsis:
         continue

      # Track program names (.Nm):
      nmMatch: re.Match[str] | None = nmPattern.match(stripped)
      if nmMatch:
         rawArg: str | None = nmMatch.group(1)
         cleanedName: str   = ""
         trailingArgs: str  = ""
         trailingMacro: str = ""

         if rawArg:
            cleanedNm: str      = cleanMdocEscapes(rawArg).strip()
            nmTokens: list[str] = cleanedNm.split()
            if nmTokens:
               cleanedName = nmTokens[0]
               if len(nmTokens) > 1:
                  trailingArgs  = parseTokens(
                     nmTokens[1:], includeArgs = True, useStyles = True
                  )
                  trailingMacro = parseTokensMacro(nmTokens[1:])

            if not firstProgramName:
               firstProgramName = cleanedName
         elif firstProgramName:
            cleanedName = firstProgramName

         entries.append(
            CommandEntry(
               name      = cleanedName or firstProgramName,
               args      = trailingArgs,
               macroArgs = trailingMacro,
            )
         )
         hasSeenOptionsForCmd = False
         continue

      # Track section subtitles (.Sy):
      syMatch: re.Match[str] | None = syPattern.match(stripped)
      if syMatch:
         rawSy: str = cleanMdocEscapes(syMatch.group(1) or "").strip()
         if rawSy:
            entries.append(
               CommandEntry(
                  name      = rawSy,
                  args      = "",
                  macroArgs = "",
               )
            )
            hasSeenOptionsForCmd = False
         continue

      # Track command arguments (.No / .Ar / .Cm / .Sy / .Bro):
      noMatch: re.Match[str] | None = noPattern.match(stripped)
      if noMatch:
         macroType: str      = noMatch.group(1)
         noContent: str      = cleanMdocEscapes(noMatch.group(2) or "")
         noTokens: list[str] = noContent.split()
         if noTokens:
            tokensToParse: list[str] = [macroType] + noTokens
            extraArgs: str  = parseTokens(
               tokensToParse, includeArgs = True, useStyles = True
            )
            extraMacro: str = parseTokensMacro(tokensToParse)

            if hasSeenOptionsForCmd:
               entries.append(
                  ArgumentEntry(
                     text      = extraArgs,
                     macroText = extraMacro,
                  )
               )
            elif entries and isinstance(entries[-1], CommandEntry):
               lastCmd: CommandEntry = entries[-1]
               combinedArgs: str  = (
                  f"{lastCmd.args} {extraArgs}".strip()
                  if lastCmd.args
                  else extraArgs
               )
               combinedMacro: str = (
                  f'{lastCmd.macroArgs} " " {extraMacro}'.strip()
                  if lastCmd.macroArgs
                  else extraMacro
               )
               entries[-1] = CommandEntry(
                  name      = lastCmd.name,
                  args      = combinedArgs,
                  macroArgs = combinedMacro,
               )
         continue

      # Track option definitions (.Op):
      opMatch: re.Match[str] | None = opPattern.match(stripped)
      if opMatch:
         opContent: str      = cleanMdocEscapes(opMatch.group(1) or "")
         opTokens: list[str] = opContent.split()
         if opTokens:
            styledInner: str = parseTokens(
               opTokens, includeArgs = True, useStyles = True
            )
            textVal: str     = f"{styleBold}[{styleReset}{styledInner}{styleBold}]{styleReset}"
            optOnlyVal: str  = parseTokens(
               opTokens, includeArgs = False, useStyles = False
            )
            macroVal: str    = parseTokensMacro(opTokens)
            entries.append(
               OptionEntry(
                  text        = textVal,
                  optionsOnly = optOnlyVal,
                  macroText   = macroVal,
               )
            )
            hasSeenOptionsForCmd = True

   return entries, firstProgramName


# ###### Sorting order for options ##########################################
def sortOptionKey(opt: OptionEntry) -> tuple[int, str, str]:
   """Key for sorting options: short options first (0), long options second (1), other third (2)."""
   plain: str = (
      opt.text.replace(styleBold, "")
      .replace(styleUnderline, "")
      .replace(styleReset, "")
      .lstrip("[")
      .strip()
   )
   priority: int
   if plain.startswith("-") and not plain.startswith("--"):
      priority = 0
   elif plain.startswith("--"):
      priority = 1
   else:
      priority = 2
   return (priority, plain.casefold(), plain)


# ###### Sort option entries ################################################
def sortEntries(entries: Sequence[Entry]) -> list[Entry]:
   """Sort option entries per program name (.Nm): short options first, then long options."""
   sortedEntries: Final[list[Entry]]        = []
   currentOptions: Final[list[OptionEntry]] = []

   def flushOptions() -> None:
      if currentOptions:
         currentOptions.sort(key = sortOptionKey)
         sortedEntries.extend(currentOptions)
         currentOptions.clear()

   for entry in entries:
      if isinstance(entry, CommandEntry):
         flushOptions()
         sortedEntries.append(entry)
      elif isinstance(entry, OptionEntry):
         currentOptions.append(entry)
      elif isinstance(entry, ArgumentEntry):
         flushOptions()
         sortedEntries.append(entry)

   flushOptions()
   return sortedEntries


# ###### Write "syntax" output ##############################################
def renderSyntax(entries: Sequence[Entry]) -> str:
   """Render entries with program names, required arguments, and tab-indented option syntax."""
   lines: Final[list[str]] = []
   for entry in entries:
      if isinstance(entry, CommandEntry):
         styledName: str = f"{styleBold}{entry.name}{styleReset}"
         if entry.args:
            lines.append(f"{styledName} {entry.args}")
         else:
            lines.append(styledName)
      elif isinstance(entry, (OptionEntry, ArgumentEntry)):
         lines.append(f"\t{entry.text}")
   return "\n".join(lines)


# ###### Write "options-only" output ########################################
def renderOptionsOnly(entries: Sequence[Entry]) -> str:
   """Render only option definitions without program names or arguments."""
   lines: Final[list[str]] = [
      entry.optionsOnly
      for entry in entries
      if isinstance(entry, OptionEntry) and entry.optionsOnly.strip()
   ]
   return "\n".join(lines)


# ###### Write "usage-c" output #############################################
def renderUsageC(
   entries: Sequence[Entry],
   firstProgramName: str,
   withGettext: bool = False,
) -> str:
   """Generate a complete C usage() function with fprintf(stderr, ...) and C macros."""
   lines: Final[list[str]] = list(cUsageHead)

   if withGettext:
      lines.extend(cTranslatorsComment)

   indent: Final[str]      = " " * 11
   entryIndent: Final[str] = " " * 14
   usageHeader: Final[str] = "%s" if withGettext else "Usage:"

   if not entries:
      if withGettext:
         lines.append(f'   fprintf(stderr, HEADER("%s") "\\n",\n{indent}gettext("Usage:"));')
      else:
         lines.append('   fprintf(stderr, HEADER("Usage:") "\\n");')
      lines.extend(cUsageTail)
      return "\n".join(lines)

   lines.append(f'   fprintf(stderr, HEADER("{usageHeader}") "\\n"')

   arguments: Final[list[str]] = []
   if withGettext:
      arguments.append('gettext("Usage:")')

   for entry in entries:
      if isinstance(entry, CommandEntry):
         if entry.name == firstProgramName:
            arguments.append("program")
            if entry.macroArgs:
               lines.append(f'{indent}CMD("%s") " " {entry.macroArgs} "\\n"')
            else:
               lines.append(f'{indent}CMD("%s\\n")')
         else:
            if entry.macroArgs:
               lines.append(f'{indent}CMD("{entry.name}") " " {entry.macroArgs} "\\n"')
            else:
               lines.append(f'{indent}CMD("{entry.name}\\n")')
      elif isinstance(entry, OptionEntry):
         lines.append(f"{entryIndent}ENTRY({entry.macroText})")
      elif isinstance(entry, ArgumentEntry):
         lines.append(f'{entryIndent}"\\t" {entry.macroText} "\\n"')

   if arguments:
      lines[-1] = lines[-1] + ","
      argsList: Final[str] = ", ".join(arguments)
      lines.append(f"{indent}{argsList});")
   else:
      lines[-1] = lines[-1] + ");"

   lines.extend(cUsageTail)
   return "\n".join(lines)


# ###### Write "usage-c++" output ###########################################
def renderUsageCpp(
   entries: Sequence[Entry],
   firstProgramName: str,
   withGettext: bool = False,
) -> str:
   """Generate a complete C++ usage() function with std::cerr using C++ macros."""
   lines: Final[list[str]] = list(cppUsageHead)
   lines.extend(cppUsageVariables)
   lines.append("")

   if withGettext:
      lines.extend(cppTranslatorsComment)

   headerText: Final[str] = 'gettext("Usage:")' if withGettext else '"Usage:"'

   if not entries:
      lines.append(f'   std::cerr << HEADER({headerText}) << "\\n"')
      lines.extend(cppUsageFooter)
      lines.extend(cppUsageTail)
      return "\n".join(lines)

   lines.append(f'   std::cerr << HEADER({headerText}) << "\\n"')

   for entry in entries:
      if isinstance(entry, CommandEntry):
         progVar: str = "program" if entry.name == firstProgramName else f'"{entry.name}"'
         if entry.macroArgs:
            lines.append(f'             << CMD({progVar}) << " "\n                {entry.macroArgs} "\\n"')
         else:
            lines.append(f'             << CMD({progVar}) << "\\n"')
      elif isinstance(entry, OptionEntry):
         lines.append(f"                   ENTRY({entry.macroText})")
      elif isinstance(entry, ArgumentEntry):
         lines.append(f'                   "\\t" {entry.macroText} "\\n"')

   lines.extend(cppUsageFooter)
   lines.extend(cppUsageTail)
   return "\n".join(lines)


# ###### Write "usage-shell" output #########################################
def renderUsageShell(
   entries: Sequence[Entry],
   firstProgramName: str,
   withGettext: bool = False,
) -> str:
   """Generate a complete Shell/Bash usage() function using a here-document."""
   lines: Final[list[str]] = [
      "# ###### Usage ##############################################################",
      "usage () {",
      '   local program="$1"',
      '   local exitCode="$2"',
      "   local header=$'\\x1b[4m'",
      "   local cmd=$'\\x1b[1m'",
   ]

   usageHeader: Final[str] = (
      '$(gettext "Usage:")' if withGettext else "Usage:"
   )

   bodyLines: Final[list[str]] = [
      f"${{header}}{usageHeader}${{reset}}",
   ]

   for entry in entries:
      if isinstance(entry, CommandEntry):
         progToken: str = "${program}" if entry.name == firstProgramName else entry.name
         if entry.args:
            escapedArgs: str = (
               entry.args.replace("\\", "\\\\")
               .replace('"', '\\"')
               .replace("$", "\\$")
               .replace("`", "\\`")
               .replace(styleBold, "${syn}")
               .replace(styleUnderline, "${arg}")
               .replace(styleReset, "${reset}")
            )
            bodyLines.append(f"${{cmd}}{progToken}${{reset}} {escapedArgs}")
         else:
            bodyLines.append(f"${{cmd}}{progToken}${{reset}}")
      elif isinstance(entry, OptionEntry):
         escapedOpt: str = (
            entry.text.replace("\\", "\\\\")
            .replace('"', '\\"')
            .replace("$", "\\$")
            .replace("`", "\\`")
            .replace(styleBold, "${opt}")
            .replace(styleUnderline, "${arg}")
            .replace(styleReset, "${reset}")
         )
         escapedOpt = (
            escapedOpt.replace("${opt}[${reset}", "${syn}[${reset}")
            .replace("${opt}]${reset}", "${syn}]${reset}")
            .replace("${opt}|${reset}", "${syn}|${reset}")
            .replace("${opt}{${reset}", "${syn}{${reset}")
            .replace("${opt}}${reset}", "${syn}}${reset}")
         )
         bodyLines.append(f"\t{escapedOpt}")
      elif isinstance(entry, ArgumentEntry):
         escapedArg: str = (
            entry.text.replace("\\", "\\\\")
            .replace('"', '\\"')
            .replace("$", "\\$")
            .replace("`", "\\`")
            .replace(styleBold, "${syn}")
            .replace(styleUnderline, "${arg}")
            .replace(styleReset, "${reset}")
         )
         bodyLines.append(f"\t{escapedArg}")

   bodyText: Final[str] = "\n".join(bodyLines)
   hasOpt: Final[bool]  = "${opt}" in bodyText
   hasArg: Final[bool]  = "${arg}" in bodyText
   hasSyn: Final[bool]  = "${syn}" in bodyText

   lines.append(f"{'   ' if hasOpt else '   # '}local opt=$'\\x1b[1m'")
   lines.append(f"{'   ' if hasArg else '   # '}local arg=$'\\x1b[4m'")
   lines.append(f"{'   ' if hasSyn else '   # '}local syn=$'\\x1b[1m'")
   lines.append("   local reset=$'\\x1b[0m'")

   if withGettext:
      lines.extend(shellTranslatorsComment)

   lines.append("   cat >&2 <<EOF")
   lines.extend(bodyLines)
   lines.append("EOF")
   lines.extend(shellUsageTail)

   return "\n".join(lines)


# ###### Write "usage-perl" output ##########################################
def renderUsagePerl(
   entries: Sequence[Entry],
   firstProgramName: str,
   withGettext: bool = False,
) -> str:
   """Generate a complete Perl usage() function using a here-document."""
   lines: Final[list[str]] = [
      "# ###### Usage ##############################################################",
      "sub usage($$) {",
      "   my ($program, $exitCode) = @_;",
      '   my $header = "\\x1b[4m";',
      '   my $cmd    = "\\x1b[1m";',
   ]

   usageHeaderToken: Final[str] = (
      "${usageHeader}" if withGettext else "Usage:"
   )

   bodyLines: Final[list[str]] = [
      f"${{header}}{usageHeaderToken}${{reset}}",
   ]

   for entry in entries:
      if isinstance(entry, CommandEntry):
         progToken: str = "${program}" if entry.name == firstProgramName else entry.name
         if entry.args:
            escapedArgs: str = (
               entry.args.replace("\\", "\\\\")
               .replace("@", "\\@")
               .replace("$", "\\$")
               .replace(styleBold, "${syn}")
               .replace(styleUnderline, "${arg}")
               .replace(styleReset, "${reset}")
            )
            bodyLines.append(f"${{cmd}}{progToken}${{reset}} {escapedArgs}")
         else:
            bodyLines.append(f"${{cmd}}{progToken}${{reset}}")
      elif isinstance(entry, OptionEntry):
         escapedOpt: str = (
            entry.text.replace("\\", "\\\\")
            .replace("@", "\\@")
            .replace("$", "\\$")
            .replace(styleBold, "${opt}")
            .replace(styleUnderline, "${arg}")
            .replace(styleReset, "${reset}")
         )
         escapedOpt = (
            escapedOpt.replace("${opt}[${reset}", "${syn}[${reset}")
            .replace("${opt}]${reset}", "${syn}]${reset}")
            .replace("${opt}|${reset}", "${syn}|${reset}")
            .replace("${opt}{${reset}", "${syn}{${reset}")
            .replace("${opt}}${reset}", "${syn}}${reset}")
         )
         bodyLines.append(f"\t{escapedOpt}")
      elif isinstance(entry, ArgumentEntry):
         escapedArg: str = (
            entry.text.replace("\\", "\\\\")
            .replace("@", "\\@")
            .replace("$", "\\$")
            .replace(styleBold, "${syn}")
            .replace(styleUnderline, "${arg}")
            .replace(styleReset, "${reset}")
         )
         bodyLines.append(f"\t{escapedArg}")

   bodyText: Final[str] = "\n".join(bodyLines)
   hasOpt: Final[bool]  = "${opt}" in bodyText
   hasArg: Final[bool]  = "${arg}" in bodyText
   hasSyn: Final[bool]  = "${syn}" in bodyText

   lines.append(f"{'   ' if hasOpt else '   # '}my $opt    = \"\\x1b[1m\";")
   lines.append(f"{'   ' if hasArg else '   # '}my $arg    = \"\\x1b[4m\";")
   lines.append(f"{'   ' if hasSyn else '   # '}my $syn    = \"\\x1b[1m\";")
   lines.append('   my $reset  = "\\x1b[0m";')

   if withGettext:
      lines.extend(perlTranslatorsComment)
      lines.append('   my $usageHeader = gettext("Usage:");')

   lines.append("   print STDERR <<EOF;")
   lines.extend(bodyLines)
   lines.append("EOF")
   lines.extend(perlUsageTail)

   return "\n".join(lines)


# ###### Write output #######################################################
def renderOutput(
   entries: Sequence[Entry],
   firstProgramName: str,
   outputFormat: str,
   withGettext: bool   = False,
   withBlockTags: bool = False,
) -> str:
   """Route entries to the requested output formatter and optionally wrap in block tags."""
   fmt: Final[str] = outputFormat.strip().lower()
   result: str

   if fmt == "syntax":
      result = renderSyntax(entries)
   elif fmt == "options-only":
      result = renderOptionsOnly(entries)
   elif fmt == "usage-c":
      result = renderUsageC(entries, firstProgramName, withGettext = withGettext)
   elif fmt in ("usage-c++", "usage-cpp"):
      result = renderUsageCpp(entries, firstProgramName, withGettext = withGettext)
   elif fmt in ("usage-shell", "usage-bash"):
      result = renderUsageShell(entries, firstProgramName, withGettext = withGettext)
   elif fmt in ("usage-perl", "usage-pl"):
      result = renderUsagePerl(entries, firstProgramName, withGettext = withGettext)
   else:
      raise ValueError(
         f"Unsupported format '{outputFormat}'. "
         f"Supported: 'syntax', 'options-only', 'usage-c', 'usage-c++', 'usage-shell', 'usage-perl'."
      )

   if withBlockTags:
      tagComment: Final[str] = (
         "#" if fmt in ("usage-shell", "usage-bash", "usage-perl", "usage-pl") else "//"
      )
      return (
         f"{tagComment} ------ BEGIN-OF-USAGE-BLOCK ------\n"
         f"{result}\n"
         f"{tagComment} ------ END-OF-USAGE-BLOCK ------"
      )

   return result


# ###### Arguments parser ###################################################
def buildParser() -> argparse.ArgumentParser:
   """Build command-line arguments."""
   parser: Final[argparse.ArgumentParser] = argparse.ArgumentParser(
      description = "Extract and format options from an mdoc manpage file."
   )
   parser.add_argument(
      "manpage",
      type = Path,
      help = "Path to the manpage file."
   )
   parser.add_argument(
      "-b", "--with-block-tags",
      dest    = "withBlockTags",
      action  = "store_true",
      default = False,
      help    = "Add begin and end block tag comments around the usage function output."
   )
   parser.add_argument(
      "-F", "--format",
      dest    = "format",
      default = defaultFormat,
      choices = list(supportedFormats),
      help    = (
         "Output format: 'syntax' (default), 'options-only', 'usage-c', "
         "'usage-c++', 'usage-shell', or 'usage-perl'."
      )
   )
   parser.add_argument(
      "-g", "--with-gettext",
      dest    = "withGettext",
      action  = "store_true",
      default = False,
      help    = (
         'Use gettext("Usage:") for internationalization in "usage-c", '
         '"usage-c++", "usage-shell", and "usage-perl" output.'
      )
   )
   parser.add_argument(
      "-s", "--sorted",
      dest    = "isSorted",
      action  = "store_true",
      default = False,
      help    = "Sort option lines per program name alphabetically (short options first, then long options)."
   )
   return parser


# ###### Parse manpage and write output #####################################
def main(argv: Sequence[str] | None = None) -> int:
   parser: Final[argparse.ArgumentParser] = buildParser()
   args: Final[argparse.Namespace]        = parser.parse_args(argv)

   if not args.manpage.is_file():
      sys.stderr.write(f"ERROR: File not found: '{args.manpage}'\n")
      return 1

   try:
      rawEntries, firstProgramName = parseManpage(args.manpage)
      entries: Final[Sequence[Entry]] = (
         sortEntries(rawEntries) if args.isSorted else rawEntries
      )

      output: Final[str] = renderOutput(
         entries,
         firstProgramName = firstProgramName,
         outputFormat     = args.format,
         withGettext      = args.withGettext,
         withBlockTags    = args.withBlockTags,
      )
      if output:
         print(output)
   except Exception as err:
      sys.stderr.write(f"ERROR: {err}\n")
      return 1

   return 0


# ###### Main program #######################################################
if __name__ == "__main__":
   sys.exit(main())
